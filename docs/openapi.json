  "components": {
    "schemas": {
      "ApprovalRequest": {
        "properties": {
          "quote_digest": {
            "type": "string",
            "maxLength": 64,
            "minLength": 64,
            "title": "Quote Digest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quote_digest"
        ],
        "title": "ApprovalRequest"
      },
      "ExecutionRequest": {
        "properties": {
          "quote_id": {
            "type": "string",
            "title": "Quote Id"
          },
          "approval_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approval Id"
          },
          "grant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Id"
          },
          "grant_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Version"
          },
          "fault_profile": {
            "type": "string",
            "enum": [
              "none",
              "payment_response_lost",
              "dispense_response_lost",
              "capture_response_lost",
              "payment_declined",
              "dispense_failed",
              "capture_declined",
              "captured_dispense_failed",
              "compensation_response_lost",
              "source_unavailable"
            ],
            "title": "Fault Profile",
            "default": "none"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quote_id"
        ],
        "title": "ExecutionRequest"
      },
      "GrantRequest": {
        "properties": {
          "product_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Product Ids"
          },
          "kiosk_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Kiosk Ids",
            "default": [
              "kiosk-a"
            ]
          },
          "per_purchase_minor": {
            "type": "integer",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Per Purchase Minor"
          },
          "total_minor": {
            "type": "integer",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Total Minor"
          },
          "max_purchases": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Purchases",
            "default": 1
          },
          "valid_for_seconds": {
            "type": "integer",
            "maximum": 86400.0,
            "minimum": 1.0,
            "title": "Valid For Seconds",
            "default": 3600
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "product_ids",
          "per_purchase_minor",
          "total_minor"
        ],
        "title": "GrantRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "persona": {
            "type": "string",
            "enum": [
              "alex",
              "sam",
              "operator"
            ],
            "title": "Persona",
            "default": "alex"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "LoginRequest"
      },
      "PriceUpdate": {
        "properties": {
          "price_minor": {
            "type": "integer",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Price Minor"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "price_minor"
        ],
        "title": "PriceUpdate"
      },
      "SessionRequest": {
        "properties": {
          "request": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Request"
          },
          "grant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request"
        ],
        "title": "SessionRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
